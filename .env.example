# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
DISCORD_TOKEN=
# Discord user IDs allowed to run the management commands, comma separated.
# Enable Developer Mode in Discord, then right-click yourself → Copy User ID.
OWNER_IDS=

# ── Copier (read-only) ────────────────────────────────────────────────────────
# Where the copier's API lives, and the same basic-auth pair the dashboard uses.
# In Docker this must not be 127.0.0.1 — that is the container itself.
COPIER_URL=http://host.docker.internal:8080
COPIER_USER=
COPIER_PASSWORD=

# ── Behaviour ─────────────────────────────────────────────────────────────────
# How often the leader's book is read, in seconds.
POLL_SECONDS=3
# On a cold start the book is adopted silently. Set true to announce whatever is
# already resting instead — useful once, when first wiring a channel up.
SEED_ALERTS=false
# Say whether a closed trade ended up or down. A direction, never a figure.
SHOW_OUTCOME=true

# ── MEXC (optional second feed) ───────────────────────────────────────────────
# A futures API key with READ permission only — this bot never trades. Leave
# blank to watch Hyperliquid alone. Alerts post to the same channels, tagged MEXC.
MEXC_API_KEY=
MEXC_API_SECRET=
# The public risk % to show on MEXC alerts (the copier's remap doesn't apply).
MEXC_RISK_PCT=
